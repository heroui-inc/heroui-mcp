{
  "extends": "@heroui/config/tsconfig/cloudflare-worker.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types", "node"],
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    "lib/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts",
    "package.json"
  ],
  "exclude": ["node_modules", "dist", "mastra", ".mastra"]
}
