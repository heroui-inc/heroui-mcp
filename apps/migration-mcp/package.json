{
  "name": "@heroui/migration-mcp",
  "version": "1.0.0-alpha.1",
  "type": "module",
  "description": "MCP server for HeroUI v2 to v3 migration instructions via Streamable HTTP",
  "keywords": [
    "mcp",
    "heroui",
    "heroui-v3",
    "migration",
    "model-context-protocol",
    "ai",
    "llm"
  ],
  "author": "HeroUI <support@heroui.com> (https://github.com/heroui-inc)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heroui-inc/heroui-mcp.git",
    "directory": "apps/migration-mcp"
  },
  "bugs": {
    "url": "https://github.com/heroui-inc/heroui-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/heroui-inc/heroui-mcp/tree/main/apps/migration-mcp",
  "prettier": "@heroui/config/prettier",
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "dotenv -- wrangler dev src/api.ts --env development --port 8790 --inspector-port 9232",
    "deploy": "wrangler deploy src/api.ts --minify",
    "deploy:staging": "wrangler deploy src/api.ts --env staging",
    "deploy:production": "wrangler deploy src/api.ts --env production",
    "inspect": "npx @modelcontextprotocol/inspector --transport http --server-url http://localhost:8790/",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\"",
    "clean": "rm -rf dist dist-api"
  },
  "dependencies": {
    "@heroui/analytics": "workspace:*",
    "@heroui/config": "workspace:*",
    "@hono/mcp": "^0.1.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hono": "^4.13.5",
    "posthog-node": "^5.51.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^22.20.1",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "wrangler": "^4.128.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.17.0"
}
