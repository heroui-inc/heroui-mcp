# Environment Configuration for HeroUI MCP Server

# Environment: development, staging, production
APP_ENV=development
NODE_ENV=development

# R2 Storage Configuration (Optional - will fallback to API if not set)
# Get these from Cloudflare R2 dashboard
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=heroui-mcp

# API Configuration
HEROUI_API_URL=https://mcp.heroui.com

# Analytics (Optional)
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Server Port (for local development)
PORT=8787