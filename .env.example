# Consolidated environment variables for HeroUI React MCP

# ------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------
# Environment: development, staging, production
APP_ENV=development
NODE_ENV=development
LOG_LEVEL=debug

# MCP Server URL
# Defaults to http://localhost:8787
HEROUI_API_URL=http://localhost:8787

# Server Port (for local development)
PORT=8787

# ------------------------------------------------------------
# Cloudflare Configuration (Optional)
# ------------------------------------------------------------
# Get these from Cloudflare R2 dashboard
# If not set, will fallback to API
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ------------------------------------------------------------
# GitHub Configuration (Optional)
# ------------------------------------------------------------
# GitHub personal access token for fetching repository data
GITHUB_TOKEN=

# ------------------------------------------------------------
# PostHog Analytics Configuration (Optional)
# ------------------------------------------------------------
# These values are only used for local development
# Production values are set in wrangler.toml
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ------------------------------------------------------------
# Model Providers (for Mastra Playground testing)
# ------------------------------------------------------------
# Choose one provider and uncomment its configuration

## Anthropic
ANTHROPIC_API_KEY=
## Optional model ID
ANTHROPIC_MODEL=

## OpenAI
OPENAI_API_KEY=
## Optional model ID
OPENAI_MODEL=

## AWS Bedrock
AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=
## Optional model ID
BEDROCK_MODEL=