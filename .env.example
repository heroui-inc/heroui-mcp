# Envs for testing locally with Mastra Playground


# Model Provider (choose one)

## Anthropic
# ANTHROPIC_API_KEY=
## Optional model ID
# ANTHROPIC_MODEL=

## OpenAI
# OPENAI_API_KEY=
## Optional model ID
# OPENAI_MODEL=

## AWS Bedrock
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
## Optional model ID
# BEDROCK_MODEL=


# MCP Server URL
## Optional, defaults to http://localhost:8787
# HEROUI_API_URL=
